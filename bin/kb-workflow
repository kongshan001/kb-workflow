#!/usr/bin/env bash
# kb-workflow - CLI for KB ingestion workflow
#
# Subcommands:
#   install   - one-click setup (handled by install.sh, this just redirects)
#   status    - show current state
#   update    - check for and apply updates
#   uninstall - clean removal

set -euo pipefail

# ---------- resolve KB paths (XDG-style single-root + per-path overrides) ----------
# v0.3.4 (single-root pattern, inspired by XDG_DATA_HOME / CARGO_HOME / Obsidian vault):
#
# KB_HOME   — single config root (all paths derive from it unless individually overridden)
# KB_ROOT   — KB data dir override (entries/, external/, _state.md)
# KB_STATE_FILE / KB_CONFIG_FILE / KB_INDEX_FILE — fine-grained overrides
# KB_WORKFLOW_HOME — skill source dir (where SKILL.md lives)
#
# Resolution chain:
#   1. per-path env var (KB_ROOT, KB_STATE_FILE, etc.) — always wins
#   2. KB_HOME (single-root) + relative path
#   3. walk-up from SCRIPT_DIR looking for .claude/kb/
#   4. global default: $HOME/.claude/kb/
#
# Run `kb-workflow doctor` to see resolved paths for debugging.
SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

if [[ -z "${KB_ROOT:-}" ]]; then
  if [[ -n "${KB_HOME:-}" ]]; then
    KB_ROOT="$KB_HOME"
  else
    CANDIDATE="$SCRIPT_DIR"
    KB_ROOT=""
    while [[ "$CANDIDATE" != "/" && "$CANDIDATE" != "" ]]; do
      if [[ -d "$CANDIDATE/.claude/kb" ]]; then
        KB_ROOT="$CANDIDATE/.claude/kb"
        break
      fi
      CANDIDATE="$(dirname "$CANDIDATE")"
    done
    if [[ -z "$KB_ROOT" ]]; then
      KB_ROOT="$HOME/.claude/kb"
    fi
  fi
fi

# Derived paths (env overrides win over derived defaults)
KB_STATE_FILE="${KB_STATE_FILE:-$KB_ROOT/_state.md}"
KB_CONFIG_FILE="${KB_CONFIG_FILE:-$KB_ROOT/config.local.yaml}"
KB_INDEX_FILE="${KB_INDEX_FILE:-$KB_ROOT/external/_index.md}"
export KB_STATE_FILE KB_CONFIG_FILE KB_INDEX_FILE KB_ROOT KB_HOME

# Resolve WORKFLOW_HOME via fallback chain (v0.3.4 Windows-aware):
#   1. POSIX symlink resolution (readlink -f)
#   2. .installed_source file (Windows fallback when ln -sf → file copy)
#   3. heuristic: assume script is at <workflow_home>/bin/kb-workflow
WORKFLOW_HOME=""
if [[ -L "$SCRIPT_PATH" ]]; then
  REAL_SCRIPT="$(readlink -f "$SCRIPT_PATH" 2>/dev/null || readlink "$SCRIPT_PATH")"
  WORKFLOW_HOME="$(cd "$(dirname "$REAL_SCRIPT")/.." && pwd 2>/dev/null || echo "")"
fi
if [[ -z "$WORKFLOW_HOME" || ! -f "$WORKFLOW_HOME/SKILL.md" ]]; then
  # Fallback 2: .installed_source file (written by install.sh for Windows)
  if [[ -f "$SCRIPT_DIR/.installed_source" ]]; then
    SRC="$(head -n1 "$SCRIPT_DIR/.installed_source" 2>/dev/null | tr -d '[:space:]')"
    if [[ -n "$SRC" && -d "$SRC" && -f "$SRC/SKILL.md" ]]; then
      WORKFLOW_HOME="$SRC"
    fi
  fi
fi
if [[ -z "$WORKFLOW_HOME" || ! -f "$WORKFLOW_HOME/SKILL.md" ]]; then
  # Fallback 3: assume script is in <workflow_home>/bin/
  HEURISTIC="$(cd "$SCRIPT_DIR/.." && pwd 2>/dev/null || echo "")"
  if [[ -n "$HEURISTIC" && -f "$HEURISTIC/SKILL.md" ]]; then
    WORKFLOW_HOME="$HEURISTIC"
  fi
fi
if [[ -z "$WORKFLOW_HOME" ]]; then
  echo "  ❌  cannot resolve WORKFLOW_HOME — set KB_WORKFLOW_HOME env" >&2
  exit 1
fi
export WORKFLOW_HOME

VERSION="0.3.3-dev"

# ---------- colors ----------
if [[ -t 1 ]]; then
  C_RESET='\033[0m'; C_DIM='\033[2m'; C_BOLD='\033[1m'
  C_GREEN='\033[32m'; C_YELLOW='\033[33m'; C_RED='\033[31m'; C_BLUE='\033[34m'
else
  C_RESET=''; C_DIM=''; C_BOLD=''
  C_GREEN=''; C_YELLOW=''; C_RED=''; C_BLUE=''
fi
say()  { printf '%b\n' "$*"; }
hdr()  { say "${C_BOLD}${C_BLUE}$*${C_RESET}"; }
ok()   { say "  ${C_GREEN}✅${C_RESET} $*"; }
warn() { say "  ${C_YELLOW}⚠️ ${C_RESET} $*"; }
err()  { say "  ${C_RED}❌${C_RESET} $*"; }

usage() {
  cat <<EOF
${C_BOLD}kb-workflow${C_RESET} v${VERSION} — KB ingestion workflow CLI

${C_BOLD}Usage:${C_RESET}
  kb-workflow <command> [args]

${C_BOLD}Commands:${C_RESET}
  status      Show installed state, capabilities, queue stats
  update      Check for and apply updates (auto for patch/minor)
  uninstall   Clean removal (keeps KB data unless --purge)
  version     Print version
  help        This help

${C_BOLD}Env:${C_RESET}
  KB_ROOT     Override KB root (default: $HOME/.claude/kb)
  KB_WORKFLOW_REPO  Override GitHub repo URL (for fresh install)
EOF
}

# ---------- subcommands ----------
cmd_status() {
  hdr "📊 KB workflow status"
  say "  ${C_DIM}workflow:${C_RESET} $WORKFLOW_HOME (v${VERSION})"
  say "  ${C_DIM}kb_root:${C_RESET}  $KB_ROOT"
  say ""

  if [[ -f "$KB_ROOT/.installed_source" ]]; then
    say "  ${C_DIM}installed_from:${C_RESET} $(cat "$KB_ROOT/.installed_source")"
  fi

  # counts (precise: parse frontmatter type: field)
  local entries external conflicts tentative
  entries=$(find "$KB_ROOT/entries" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
  # exclude underscore-prefixed files (e.g. _index.md) from external count
  external=$(find "$KB_ROOT/external" -name "*.md" -type f ! -name "_*" 2>/dev/null | wc -l | tr -d ' ')

  # count entries by type (parse frontmatter "type:" field)
  local fact_n pref_n dec_n tent_n
  fact_n=$(grep -l '^  type: fact' "$KB_ROOT/entries"/*.md 2>/dev/null | wc -l | tr -d ' ')
  pref_n=$(grep -l '^  type: preference' "$KB_ROOT/entries"/*.md 2>/dev/null | wc -l | tr -d ' ')
  dec_n=$(grep -l '^  type: decision' "$KB_ROOT/entries"/*.md 2>/dev/null | wc -l | tr -d ' ')
  tent_n=$(grep -l '^  type: tentative' "$KB_ROOT/entries"/*.md 2>/dev/null | wc -l | tr -d ' ')

  # conflicts: count "## ⚠️" + non-empty items (lines starting with "- " inside ⚠️ section)
  if [[ -f "$KB_ROOT/_state.md" ]]; then
    conflicts=$(awk '/^## ⚠️/{flag=1; next} /^## /{flag=0} flag && /^- /{c++} END{print c+0}' "$KB_ROOT/_state.md")
    tentative=$(awk '/^## 🟡/{flag=1; next} /^## /{flag=0} flag && /^- /{c++} END{print c+0}' "$KB_ROOT/_state.md")
  else
    conflicts=0; tentative=0
  fi

  say "  ${C_BOLD}Stats${C_RESET}"
  say "    entries/:    $entries  (fact=$fact_n preference=$pref_n decision=$dec_n tentative=$tent_n)"
  say "    external/:   $external"
  say "    待裁定:     $conflicts"
  say "    tentative:   $tentative (open)"
  say ""

  # capabilities
  hdr "🔧 Capabilities"
  if [[ -x "$WORKFLOW_HOME/scripts/capability-detect.sh" ]]; then
    "$WORKFLOW_HOME/scripts/capability-detect.sh" 2>/dev/null | sed 's/^/  /' || warn "capability-detect failed"
  else
    warn "capability-detect.sh not found"
  fi
  say ""

  # staleness
  if [[ -x "$WORKFLOW_HOME/scripts/check-staleness.sh" ]]; then
    local stale
    stale=$("$WORKFLOW_HOME/scripts/check-staleness.sh" 2>/dev/null || echo "")
    if [[ -n "$stale" ]]; then
      warn "Workflow behind remote — run: kb-workflow update"
    else
      ok "Workflow up to date"
    fi
  fi
  say ""

  # commands reminder
  hdr "🛠  In Claude session"
  say "    /kb-review   /kb-search X   /kb-status   /kb-workflow update"
}

cmd_update() {
  hdr "🔄 Checking for updates"
  if [[ ! -d "$WORKFLOW_HOME/.git" ]]; then
    warn "workflow home $WORKFLOW_HOME is not a git repo"
    warn "skip update check (this is expected for local-dev installs)"
    return 0
  fi

  local local_commit remote_commit
  local_commit=$(git -C "$WORKFLOW_HOME" rev-parse HEAD 2>/dev/null || echo "none")

  # try fetch
  if ! git -C "$WORKFLOW_HOME" fetch --quiet 2>/dev/null; then
    warn "fetch failed (offline?) — using local version"
    return 0
  fi

  # try to find remote
  local remote_branch
  remote_branch=$(git -C "$WORKFLOW_HOME" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "")
  if [[ -z "$remote_branch" ]]; then
    warn "no upstream configured — skip update check"
    return 0
  fi
  remote_commit=$(git -C "$WORKFLOW_HOME" rev-parse "$remote_branch" 2>/dev/null || echo "")

  if [[ "$local_commit" == "$remote_commit" ]]; then
    ok "already at latest ($local_commit)"
    return 0
  fi

  # determine bump type from version
  local local_ver
  local_ver=$(grep -m1 '^VERSION=' "$WORKFLOW_HOME/bin/kb-workflow" | cut -d'"' -f2 || echo "0.0.0")
  # crude semver comparison
  local major minor patch
  IFS='.' read -r major minor patch <<< "${local_ver%%-*}"

  # check if major bump in remote
  local remote_ver="0.0.0"
  # not perfect but safe — treat any divergence with major as major
  # simplified: ask user if they want to proceed
  say ""
  warn "Local:  $local_ver ($local_commit)"
  warn "Remote: $remote_ver ($remote_commit)"
  say ""
  say "  ${C_YELLOW}If this is a major version change, schema may be incompatible.${C_RESET}"
  read -r -p "  Pull updates? [y/N] " ans
  if [[ "$ans" =~ ^[Yy]$ ]]; then
    git -C "$WORKFLOW_HOME" pull --ff-only && ok "updated to $remote_commit"
  else
    warn "skipped"
  fi
}

cmd_uninstall() {
  exec "$WORKFLOW_HOME/uninstall.sh" "$@"
}

cmd_install() {
  exec "$WORKFLOW_HOME/install.sh" "$@"
}

cmd_version() {
  say "kb-workflow v${VERSION}"
}

cmd_doctor() {
  hdr "🩺 kb-workflow doctor (diagnose paths + health)"

  say ""
  say "  ${C_BOLD}Platform${C_RESET}"
  say "    uname:      $(uname -s 2>/dev/null || echo '?')"
  say "    \$HOME:      ${HOME:-<unset>}"
  if [[ "$(uname -s 2>/dev/null)" =~ MINGW|MSYS|CYGWIN ]]; then
    say "    \$USERPROFILE: ${USERPROFILE:-<unset>}"
    say "    mode:       Windows (Git Bash)"
  fi

  say ""
  say "  ${C_BOLD}Resolved paths${C_RESET} (env overrides shown)"
  if [[ -n "${KB_HOME:-}" ]]; then
    say "    KB_HOME (single-root): ${C_GREEN}$KB_HOME${C_RESET}  ${C_DIM}← env${C_RESET}"
  fi
  if [[ -n "${KB_ROOT:-}" ]]; then
    say "    KB_ROOT (override):   ${C_GREEN}$KB_ROOT${C_RESET}  ${C_DIM}← env${C_RESET}"
  else
    say "    KB_ROOT (auto-detect): ${C_GREEN}$KB_ROOT${C_RESET}"
  fi
  if [[ -n "${KB_STATE_FILE:-}" ]]; then
    say "    KB_STATE_FILE:        ${C_GREEN}$KB_STATE_FILE${C_RESET}  ${C_DIM}← env${C_RESET}"
  else
    say "    KB_STATE_FILE:        ${C_GREEN}$KB_STATE_FILE${C_RESET}  ${C_DIM}(derived from KB_ROOT)${C_RESET}"
  fi
  if [[ -n "${KB_CONFIG_FILE:-}" ]]; then
    say "    KB_CONFIG_FILE:       ${C_GREEN}$KB_CONFIG_FILE${C_RESET}  ${C_DIM}← env${C_RESET}"
  else
    say "    KB_CONFIG_FILE:       ${C_GREEN}$KB_CONFIG_FILE${C_RESET}  ${C_DIM}(derived)${C_RESET}"
  fi
  if [[ -n "${KB_INDEX_FILE:-}" ]]; then
    say "    KB_INDEX_FILE:        ${C_GREEN}$KB_INDEX_FILE${C_RESET}  ${C_DIM}← env${C_RESET}"
  else
    say "    KB_INDEX_FILE:        ${C_GREEN}$KB_INDEX_FILE${C_RESET}  ${C_DIM}(derived)${C_RESET}"
  fi
  if [[ -n "${KB_WORKFLOW_HOME:-}" ]]; then
    say "    KB_WORKFLOW_HOME:     ${C_GREEN}$KB_WORKFLOW_HOME${C_RESET}  ${C_DIM}← env${C_RESET}"
  else
    say "    KB_WORKFLOW_HOME:     ${C_GREEN}$WORKFLOW_HOME${C_RESET}  ${C_DIM}(from .installed_source / readlink)${C_RESET}"
  fi

  say ""
  say "  ${C_BOLD}Health checks${C_RESET}"
  local issues=0
  for p in "$KB_ROOT" "$KB_ROOT/entries" "$KB_ROOT/external"; do
    if [[ -d "$p" && -w "$p" ]]; then
      say "    ${C_GREEN}✓${C_RESET} $p (writable)"
    elif [[ -d "$p" ]]; then
      say "    ${C_RED}✗${C_RESET} $p (exists but NOT writable)"
      issues=$((issues+1))
    else
      say "    ${C_RED}✗${C_RESET} $p (missing)"
      issues=$((issues+1))
    fi
  done
  for p in "$KB_STATE_FILE" "$KB_CONFIG_FILE" "$KB_INDEX_FILE"; do
    if [[ -f "$p" ]]; then
      say "    ${C_GREEN}✓${C_RESET} $p"
    else
      say "    ${C_YELLOW}○${C_RESET} $p (will be created on first use)"
    fi
  done

  say ""
  if [[ $issues -gt 0 ]]; then
    say "  ${C_RED}$issues issue(s) found${C_RESET}"
    say "  ${C_DIM}Hint: try KB_ROOT=/some/writable/path or fix permissions${C_RESET}"
    return 1
  else
    say "  ${C_GREEN}all paths writable${C_RESET}"
    return 0
  fi
}

# ---------- dispatch ----------
case "${1:-help}" in
  status)    shift; cmd_status "$@" ;;
  update)    shift; cmd_update "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  install)   shift; cmd_install "$@" ;;
  doctor)    shift; cmd_doctor "$@" ;;
  version|-v|--version) cmd_version ;;
  help|-h|--help|"") usage ;;
  *) err "unknown command: $1"; usage; exit 1 ;;
esac
